DECLARE nilaiAngka: INTEGER
DECLARE nilaiHuruf: STRING

INPUT nilaiAngka

IF nilaiAngka >= 90 THEN
    nilaiHuruf <- 'A'
    OUTPUT nilaiHuruf
ELSE
    IF nilaiAngka >= 80 THEN
        nilaiHuruf <- 'B'
        OUTPUT nilaiHuruf
    ELSE
        IF nilaiAngka >= 70 THEN
            nilaiHuruf <- 'C'
            OUTPUT nilaiHuruf
        ELSE
            IF nilaiAngka >= 60 THEN
                nilaiHuruf <- 'D'
                OUTPUT nilaiHuruf
            ELSE
                IF nilaiAngka >= 50 THEN
                    nilaiHuruf <- 'E'
                    OUTPUT nilaiHuruf
                ELSE
                    nilaiHuruf <- 'F'
                    OUTPUT nilaiHuruf
                ENDIF
            ENDIF
        ENDIF
    ENDIF
ENDIF